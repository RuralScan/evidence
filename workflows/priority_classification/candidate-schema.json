{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "batch_id",
    "status",
    "scope",
    "recorded_on",
    "instruction_ref",
    "instruction_sha256",
    "sources",
    "findings",
    "packet_dependencies",
    "review_events",
    "search_ref",
    "search_sha256",
    "extraction_agent"
  ],
  "properties": {
    "format": {
      "const": "ruralscan.cross-cutting-candidate.v1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "unreviewed_candidate"
    },
    "scope": {
      "const": "T5_classification_documentation"
    },
    "recorded_on": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "instruction_ref": {
      "type": "string",
      "minLength": 1
    },
    "instruction_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_source_id",
          "version",
          "canonical_source_ref",
          "title",
          "citation",
          "doi",
          "url",
          "identity_receipt",
          "artifact",
          "registration_blockers",
          "credibility"
        ],
        "properties": {
          "candidate_source_id": {
            "type": "string",
            "pattern": "^xcs_[a-z0-9_]+$"
          },
          "version": {
            "const": "0.1.0"
          },
          "canonical_source_ref": {
            "type": "null"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "identity_receipt": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha256",
              "media_type",
              "acquisition_url",
              "shared_uri"
            ],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "media_type": {
                "enum": [
                  "application/pdf",
                  "text/html"
                ]
              },
              "acquisition_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "shared_uri": {
                "type": "null"
              }
            }
          },
          "registration_blockers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "credibility": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "strength",
              "transparency",
              "authority",
              "transferability",
              "recency",
              "seminality",
              "independence"
            ],
            "properties": {
              "strength": {
                "type": "string",
                "minLength": 1
              },
              "transparency": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "type": "string",
                "minLength": 1
              },
              "transferability": {
                "type": "string",
                "minLength": 1
              },
              "recency": {
                "type": "string",
                "minLength": 1
              },
              "seminality": {
                "type": "string",
                "minLength": 1
              },
              "independence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_finding_id",
          "version",
          "candidate_source_id",
          "variables",
          "knowledge_basis",
          "reported",
          "locator",
          "excerpt",
          "context",
          "limitations",
          "review_state"
        ],
        "properties": {
          "candidate_finding_id": {
            "type": "string",
            "pattern": "^xce_[a-z0-9_]+$"
          },
          "version": {
            "const": "0.1.0"
          },
          "candidate_source_id": {
            "type": "string",
            "minLength": 1
          },
          "variables": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "knowledge_basis": {
            "const": "primary_documentation"
          },
          "reported": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "values"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "values": {
                "type": "object",
                "minProperties": 1
              }
            }
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "value"
            ],
            "properties": {
              "type": {
                "enum": [
                  "pdf_page",
                  "section"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "excerpt": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "geography",
              "period",
              "population"
            ],
            "properties": {
              "geography": {
                "type": "string",
                "minLength": 1
              },
              "period": {
                "type": "string",
                "minLength": 1
              },
              "population": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "limitations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "review_state": {
            "const": "unreviewed"
          }
        }
      }
    },
    "packet_dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "review_events": {
      "type": "array",
      "maxItems": 0
    },
    "search_ref": {
      "type": "string",
      "minLength": 1
    },
    "search_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "extraction_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "model",
        "acquisition_revision"
      ],
      "properties": {
        "tool": {
          "const": "Codex"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "acquisition_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cross-cutting T5 evidence candidate; no source or finding registration implied"
}
